{
  "name": "@ox-wire/unplugin",
  "version": "0.1.0",
  "description": "AOT build plugin for oxbt TypeScript validator and binary codec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./esbuild": {
      "import": "./dist/esbuild.js",
      "types": "./dist/esbuild.d.ts"
    },
    "./rollup": {
      "import": "./dist/rollup.js",
      "types": "./dist/rollup.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ox-wire/runtime": "workspace:*",
    "unplugin": "^2.2.0"
  },
  "devDependencies": {
    "@ox-wire/napi": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
