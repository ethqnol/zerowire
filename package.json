{
  "name": "zerowire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo build --workspace && pnpm -r build",
    "test": "pnpm -r test && vitest run tests/",
    "test:integration": "vitest run tests/",
    "typecheck": "pnpm -r typecheck",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all -- --check",
    "fmt": "cargo fmt --all",
    "bench": "pnpm --filter @zerowire/benchmarks bench"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@zerowire/napi": "workspace:*",
    "@zerowire/runtime": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
